# Storage backend: sqlite | supabase | s3 | firebase
MEMORY_BACKEND=sqlite

# LLM provider for compression: openai | anthropic | groq
MEMORY_LLM_PROVIDER=openai

# LLM API keys (only the one you use is required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# SQLite (optional — defaults to ~/.ai-memory/memory.db)
# SQLITE_DB_PATH=~/.ai-memory/memory.db

# Supabase
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=your-anon-key

# S3 / Cloudflare R2
# S3_BUCKET_NAME=my-memory-bucket
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Firebase
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=my-firebase-project
